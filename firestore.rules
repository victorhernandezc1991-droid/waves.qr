rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/admin)
        && request.auth.uid == get(/databases/$(database)/documents/config/admin).data.uid;
    }

    // ── Productos ────────────────────────────────────────────────────────────
    // Lectura pública. Solo el admin crea/borra/edita. El cliente anónimo
    // puede SOLO decrementar el campo stock dentro de una transacción de pedido.
    match /productos/{docId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
          && resource.data.stock != null
          && request.resource.data.stock is number
          && request.resource.data.stock <= resource.data.stock
          && request.resource.data.stock >= 0
        );
    }

    // ── Pedidos ──────────────────────────────────────────────────────────────
    // Lectura pública (status tracking del cliente).
    // Creación libre con validación estricta de shape (tipo + clienteInfo).
    // Update/delete solo admin.
    match /pedidos/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['tipo', 'estado', 'total', 'items', 'clienteInfo'])
        && request.resource.data.tipo in ['delivery', 'presencial', 'manual']
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.clienteInfo.nombre is string
        && request.resource.data.clienteInfo.nombre.size() > 0;
      allow update, delete: if isAdmin();
    }

    // ── Llamadas (pedir la cuenta en presencial) ─────────────────────────────
    // El cliente solo puede crear con tipo: "cuenta" + pedidoId.
    // Solo el admin lee y resuelve.
    match /llamadasMozo/{docId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.tipo == 'cuenta'
        && request.resource.data.pedidoId is string
        && request.resource.data.atendida == false;
      allow update, delete: if isAdmin();
    }

    // ── Historial y cierres de caja: solo admin ──────────────────────────────
    match /historial/{docId}   { allow read, write: if isAdmin(); }
    match /cierresCaja/{docId} { allow read, write: if isAdmin(); }

    // ── Config (comercio, local, menuDelDia, contadores, admin) ──────────────
    // Lectura pública (la app cliente lee config/comercio, config/local, config/menuDelDia).
    // El doc 'contadores' es escribible por cliente anónimo (numeración secuencial
    // dentro de la transacción de pedido), restringiendo qué campos puede tocar.
    // Resto (comercio, local, menuDelDia, admin) → solo admin.
    match /config/{docId} {
      allow read: if true;
      allow create, update: if isAdmin()
        || (
          docId == 'contadores'
          && request.resource.data.diff(resource.data == null ? {} : resource.data).affectedKeys().hasOnly(['ultimaOrden', 'fecha'])
          && request.resource.data.ultimaOrden is number
          && request.resource.data.ultimaOrden >= 1
        );
      allow delete: if isAdmin();
    }
  }
}
