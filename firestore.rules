rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Comercios: lectura pública total, escritura con auth
    match /comercios/{slug} {
      allow read: if true;
      allow write: if request.auth != null;

      match /{subcol}/{docId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /{subcol}/{docId}/{nested=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Colecciones legacy
    match /productos/{docId}     { allow read: if true; allow write: if request.auth != null; }
    match /pedidos/{docId}       { allow read, write: if true; }
    match /llamadasMozo/{docId}  { allow read, write: if true; }
    match /configuracion/{docId} { allow read: if true; allow write: if request.auth != null; }
    match /config/{docId}        { allow read: if true; allow write: if request.auth != null; }
    match /historial/{docId}     { allow read, write: if request.auth != null; }
  }
}
