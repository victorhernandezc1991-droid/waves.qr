import { useEffect, useState, useRef } from 'react';
import { db } from './firebaseConfig';
import { collection, onSnapshot, addDoc, deleteDoc, doc, updateDoc } from 'firebase/firestore';
import './App.css';

// ---COMPONENTE PRODUCTO ITEM---
function ProductoItem({ p, eliminarProducto, agregarAlCarrito, esAdmin }) {
  const [cantidad, setCantidad] = useState(1);
  const [agregado, setAgregado] = useState(false);

  // Feedback visual
  const manejarAgregar = () => {
    agregarAlCarrito(p, cantidad);
    setAgregado(true);
    setTimeout(() => setAgregado(false), 1000); // Vuelve a la normalidad tras 1 segundo
  };

  // Cambiar disponibilidad (Admin)
  const toggleDisponible = async () => {
    await updateDoc(doc(db, "productos", p.id), {
      disponible: p.disponible === false ? true : false
    });
  };

  const estaAgotado = p.disponible === false;

  return (
    <div className={`product-card ${estaAgotado ? 'agotado-card' : ''}`}>
      {p.foto && <img src={p.foto} alt={p.nombre} className="product-img" style={{ opacity: estaAgotado ? 0.5 : 1 }} />}
      <h2 className="product-name">{p.nombre} {estaAgotado && "(AGOTADO)"}</h2>
      <p className="product-price">$ {p.precio}</p>

      <div className="qty-container">
        <button disabled={estaAgotado} className="btn-qty" onClick={() => setCantidad(Math.max(1, cantidad - 1))}>-</button>
        <span className="qty-text">{cantidad}</span>
        <button disabled={estaAgotado} className="btn-qty" onClick={() => setCantidad(cantidad + 1)}>+</button>
      </div>

      <button
        className={`btn-add-cart ${agregado ? 'btn-success' : ''}`}
        onClick={manejarAgregar}
        disabled={estaAgotado}
      >
        {estaAgotado ? '🚫 Agotado' : agregado ? '¡Listo! ✅' : '🛒 Agregar al Carrito'}
      </button>

      {esAdmin && (
        <div style={{ display: 'flex', gap: '10px', marginTop: '10px' }}>
          <button className="btn-admin-small" onClick={toggleDisponible}>
            {estaAgotado ? 'Habilitar' : 'Agotar'}
          </button>
          <button className="btn-delete-db" onClick={() => eliminarProducto(p.id)}>
            Eliminar
          </button>
        </div>
      )}
    </div>
  );
}

// ---SECCIÓN DE VENTAS---
function SeccionVentas({ pedidos }) {
  const ventasHoy = pedidos.filter(p => p.estado === "finalizado");
  const totalCaja = ventasHoy.reduce((acc, p) => acc + (p.total || 0), 0);

  if (ventasHoy.length === 0) return null;

  return (
    <div style={{ background: '#222', padding: '20px', borderRadius: '10px', marginTop: '40px', border: '1px solid #444', color: 'white' }}>
      <h2 style={{ color: '#d9ed21', margin: '0 0 10px 0' }}>💰 Resumen de Caja Hoy</h2>
      <p style={{ fontSize: '1.5rem', fontWeight: 'bold', margin: '0 0 15px 0' }}>Total Recaudado: ${totalCaja}</p>
      <div style={{ maxHeight: '200px', overflowY: 'auto' }}>
        {ventasHoy.map(v => (
          <div key={v.id} style={{ borderBottom: '1px solid #444', padding: '10px 0', display: 'flex', justifyContent: 'space-between' }}>
            <span>Mesa {v.mesa}</span>
            <span><strong>${v.total}</strong> <small style={{color: '#aaa'}}>({v.entregadoHora})</small></span>
          </div>
        ))}
      </div>
    </div>
  );
}

// ---COMPONENTE PANEL COCINA---
function PanelCocina() {
  const [pedidos, setPedidos] = useState([]);
  const [interactuado, setInteractuado] = useState(false); 
  const audioNotificacion = useRef(new Audio('https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3'));
  const pedidosAnteriores = useRef(0);

  useEffect(() => {
    const unsub = onSnapshot(collection(db, "pedidos"), (snapshot) => {
      const todosLosPedidos = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      const pedidosPendientes = todosLosPedidos.filter(p => p.estado !== "finalizado");

      // Si hay un pedido pendiente nuevo y el usuario ya interactuó, suena
      if (pedidosPendientes.length > pedidosAnteriores.current && pedidosAnteriores.current !== 0 && interactuado) {
        audioNotificacion.current.play().catch(e => console.log("Audio bloqueado por el navegador"));
      }

      pedidosAnteriores.current = pedidosPendientes.length;
      setPedidos(todosLosPedidos); // Guardamos todos para pasarlos a la caja
    });
    return () => unsub();
  }, [interactuado]);

  const finalizarPedido = async (id) => {
    const pedidoRef = doc(db, "pedidos", id);
    await updateDoc(pedidoRef, {
      estado: "finalizado",
      entregadoHora: new Date().toLocaleTimeString(),
      fecha: new Date().toLocaleDateString()
    });
  };
  
  const pendientes = pedidos.filter(p => p.estado !== "finalizado");

  return (
    <div className="cocina-container" onClick={() => setInteractuado(true)}>
      <h1 className="cocina-title">👨‍🍳 COMANDAS ENTRANTES</h1>
      
      {!interactuado && <p style={{textAlign: 'center', color: '#ff4d4d', fontWeight: 'bold'}}>Toca cualquier parte de esta pantalla para activar el sonido 🔈</p>}

      <div className="cocina-grid">
        {pendientes.length === 0 ? <p>No hay pedidos pendientes...</p> : pendientes.map(p => (
          <div key={p.id} className="comanda-card">
            <h2>MESA {p.mesa}</h2>
            <p className="comanda-hora">{p.hora}</p>
            
            {/*Notas del cliente en la comanda*/}
            {p.notas && (
              <div style={{ background: '#333', padding: '10px', borderRadius: '5px', margin: '10px 0', color: '#d9ed21', fontWeight: 'bold' }}>
                ⚠️ NOTA: {p.notas}
              </div>
            )}
            
            <hr />
            <ul className="comanda-lista">
              {p.items?.map((it, i) => (
                <li key={i}>✅ {it.cantidad}x {it.nombre}</li>
              ))}
            </ul>
            <button className="btn-listo" onClick={() => finalizarPedido(p.id)}>MARCAR COMO LISTO</button>
          </div>
        ))}
      </div>

      {/*VENTAS AL FINAL DE LA COCINA*/}
      <SeccionVentas pedidos={pedidos} />
    </div>
  );
}

// ---COMPONENTE PRINCIPAL APP---
export default function App() {
  const [filtro, setFiltro] = useState("todos");
  const [productos, setProductos] = useState([]);
  const [carrito, setCarrito] = useState([]);
  const [esAdmin, setEsAdmin] = useState(false);
  const [mesa, setMesa] = useState("");
  const [notas, setNotas] = useState(""); // PASO 3: Estado para las notas

  // PASO 4: Memoria de Vista (localStorage)
  const [vistaCocina, setVistaCocina] = useState(() => {
    return localStorage.getItem('vistaPreferida') === 'cocina';
  });

  useEffect(() => {
    localStorage.setItem('vistaPreferida', vistaCocina ? 'cocina' : 'menu');
  }, [vistaCocina]);

  //Auto-llenado de Mesa por QR
  useEffect(() => {
    const params = new URLSearchParams(window.location.search);
    const mesaUrl = params.get('mesa');
    if (mesaUrl) setMesa(mesaUrl);
  }, []);

  useEffect(() => {
    const unsubscribe = onSnapshot(collection(db, "productos"), (snapshot) => {
      setProductos(snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() })));
    });
    return () => unsubscribe();
  }, []);

  const agregarAlCarrito = (producto, cantidadSeleccionada) => {
    const nuevoItem = {
      ...producto,
      cantidad: cantidadSeleccionada,
      total: (parseFloat(producto.precio) || 0) * cantidadSeleccionada
    };
    setCarrito([...carrito, nuevoItem]);
  };

  const eliminarDelCarrito = (index) => {
    setCarrito(carrito.filter((_, i) => i !== index));
  };

  const vaciarCarrito = () => {
    if (window.confirm("¿Quieres vaciar todo el pedido?")) setCarrito([]);
  };

  const eliminarProducto = async (id) => {
    if (window.confirm("¿Eliminar del menú permanentemente?")) {
      await deleteDoc(doc(db, "productos", id));
    }
  };

  const agregarProducto = async (e) => {
    e.preventDefault();
    const { nombre, precio, foto, categoria } = e.target.elements;
    await addDoc(collection(db, "productos"), {
      nombre: nombre.value,
      precio: parseFloat(precio.value),
      foto: foto.value,
      categoria: categoria.value,
      disponible: true // Por defecto disponible
    });
    e.target.reset();
  };

  const enviarPedido = async () => {
    if (!mesa) return alert("Por favor, ingresa el número de mesa");
    try {
      await addDoc(collection(db, "pedidos"), {
        mesa: mesa,
        items: carrito,
        notas: notas, // PASO 3: Enviamos las notas a la base de datos
        total: carrito.reduce((acc, item) => acc + (parseFloat(item.total) || 0), 0),
        estado: "pendiente",
        hora: new Date().toLocaleTimeString()
      });
      alert("¡Pedido enviado a cocina! 👨‍🍳");
      setCarrito([]);
      setMesa("");
      setNotas(""); // Limpiamos las notas tras enviar
    } catch (e) {
      alert("Error al enviar el pedido");
    }
  };

  return (
    <>
      {/*Botón secreto para empleados*/}
      <button
        onClick={() => setVistaCocina(!vistaCocina)}
        className="btn-toggle-vista"
      >
        {vistaCocina ? '📖 Ver Menú' : '⚙️'}
      </button>

      {vistaCocina ? <PanelCocina /> : (
        <div className="menu-container">
          <header className="header">
            <div className="header-icon" onClick={() => {
              const clave = prompt("Clave de Admin:");
              if (clave === "1234") setEsAdmin(!esAdmin);
            }}>
              <img src="/logo-waves.png" alt="Logo" />
            </div>
            <h1 className="header-title">Waves</h1>
          </header>

          {esAdmin && (
            <form onSubmit={agregarProducto} className="form-container">
              <input name="nombre" placeholder="Nombre" required className="input-base" />
              <input name="precio" type="number" placeholder="Precio" required className="input-base input-precio" />
              <input name="foto" placeholder="Link de la foto" className="input-base" />
              <select name="categoria" className="input-base">
                <option value="pizzas">Pizzas</option>
                <option value="hamburguesas">Hamburguesas</option>
                <option value="bebidas">Bebidas</option>
                <option value="postres">Postres</option>
              </select>
              <button type="submit" className="btn-submit">+ Añadir</button>
            </form>
          )}

          <div className="filtros-container">
            {["todos", "pizzas", "hamburguesas", "bebidas", "postres"].map(cat => (
              <button
                key={cat}
                onClick={() => setFiltro(cat)}
                className={`btn-filtro ${filtro === cat ? 'activo' : 'inactivo'}`}
              >
                {cat}
              </button>
            ))}
          </div>

          <div className="product-list">
            {productos
              .filter(p => filtro === "todos" || (p.categoria && p.categoria.toLowerCase() === filtro.toLowerCase()))
              .map(p => <ProductoItem key={p.id} p={p} esAdmin={esAdmin} eliminarProducto={eliminarProducto} agregarAlCarrito={agregarAlCarrito} />)
            }
          </div>

          <div className="pedido-container">
            <div className="pedido-header">
              <h2>📝 Tu Pedido</h2>
              {carrito.length > 0 && <button className="btn-vaciar" onClick={vaciarCarrito}>🗑️ Vaciar</button>}
            </div>

            {carrito.length === 0 ? <p>No has seleccionado nada aún</p> : (
              <ul className="carrito-lista">
                {carrito.map((item, index) => (
                  <li key={index} className="carrito-item">
                    <span><strong>{item.cantidad}x</strong> {item.nombre}</span>
                    <span>
                      <strong>${item.total}</strong>
                      <button className="btn-quitar-item" onClick={() => eliminarDelCarrito(index)}>✕</button>
                    </span>
                  </li>
                ))}
              </ul>
            )}

            <div className="total-enviar-section">
              <h3 className="total-texto">Total: ${carrito.reduce((acc, i) => acc + (parseFloat(i.total) || 0), 0)}</h3>

              {carrito.length > 0 && (
                <>
                  {/*Input de Notas Especiales*/}
                  <textarea
                    placeholder="¿Alguna nota especial? (Ej: Sin mayonesa, hielo aparte...)"
                    value={notas}
                    onChange={(e) => setNotas(e.target.value)}
                    style={{ 
                      width: '100%', 
                      padding: '10px', 
                      marginBottom: '10px', 
                      borderRadius: '8px', 
                      background: '#222', 
                      color: 'white', 
                      border: '1px solid #444',
                      resize: 'vertical',
                      minHeight: '60px'
                    }}
                  />

                  <input
                    type="number"
                    placeholder="N° de Mesa"
                    value={mesa}
                    onChange={(e) => setMesa(e.target.value)}
                    className="input-mesa"
                  />
                  <button onClick={enviarPedido} className="btn-enviar-cocina">
                    🔔 ENVIAR A COCINA
                  </button>
                </>
              )}
            </div>
          </div>
        </div>
      )}
    </>
  );
}