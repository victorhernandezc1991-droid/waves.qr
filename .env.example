# ────────────────────────────────────────────────────────────────────
# Variables de entorno — copiar este archivo a .env y completar valores.
# Nunca committear .env (ya está en .gitignore).
# ────────────────────────────────────────────────────────────────────

# Firebase (Web SDK config — Firebase Console > Configuración del proyecto)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email del admin global (legacy, solo se usa para el fallback de admin antes
# de que el doc del comercio cargue su ownerUid). Después se ignora.
VITE_ADMIN_EMAIL=

# Cloudinary (para subir imágenes de productos y logos de comercios)
# Crear cuenta gratis en cloudinary.com y un upload preset unsigned.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Firebase Cloud Messaging — VAPID public key
# Firebase Console > Configuración del proyecto > Cloud Messaging > Web Push certificates
# Necesario para que el admin reciba push de nuevos pedidos cuando la app está cerrada.
VITE_FIREBASE_VAPID_KEY=
